# Website CMS database (optional; use COMPANYPROFILE, separate from packages).
# If empty, CMS content uses data/cms-data.json on persistent disk.
DATABASE_URL=
# Required for public package tracking. This must point to the database containing packages
# (currently JASTIPNEW), using a dedicated SELECT-only database user.
TRACKING_DATABASE_URL=

# Google Sheet resi asal Jakarta/Surabaya; the defaults match the shared tracking tab.
GOOGLE_SHEETS_ID=15PoD1RdeIh-zfXKm7SG8nzctLINGPYe5
GOOGLE_SHEETS_GID=2035133146
# Recommended for a private sheet: create a read-only service account and share the sheet with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Required for admin login. No defaults are provided by the application.
ADMIN_EMAIL=
# Use a unique password with at least 24 characters.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48 (minimum 32 characters).
SESSION_SECRET=
